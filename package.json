{
  "name": "dsh-enter-using",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH Web UI plugin: answer command-approval prompts with Enter and number keys, Codex style.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "approval",
    "keyboard",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wukiQAQ/dsh-enter-using.git"
  },
  "homepage": "https://github.com/wukiQAQ/dsh-enter-using#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/client.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
